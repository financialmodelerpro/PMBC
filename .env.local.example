# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local, it is gitignored.

# Supabase (new project, separate from FMP)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://pacemakersglobal.com
NEXT_PUBLIC_SITE_URL=https://pacemakersglobal.com

# Brevo (transactional email)
# Create the key under Brevo > SMTP & API > API Keys. The sending domain must be
# authenticated in Brevo (SPF, DKIM, DMARC) or mail lands in spam.
BREVO_API_KEY=
EMAIL_FROM_DEFAULT=info@pacemakersglobal.com
EMAIL_FROM_NAME=PaceMakers Business Consultants
EMAIL_TO_ADMIN=advisory@pacemakersglobal.com
# Optional. Overrides the From on the acknowledgement sent to the enquirer.
# Leave blank to send it from EMAIL_FROM_DEFAULT.
EMAIL_FROM_CONTACT=

# hCaptcha
HCAPTCHA_SECRET_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Financial Modeler Pro public content feed
# Server-only. Neither is prefixed NEXT_PUBLIC_, and neither may be: the key
# would be readable by anyone viewing the page source.
# Powers /financial-modeler-pro/{modeling-hub,refm,training-hub}, which fetch
# their body content from FMP and render it through PMBC's own components.
# The key is FMP's FMP_PUBLIC_API_KEY, set on the FMP deployment. FMP fails
# closed, so an unset or wrong key returns 401 and PMBC serves its stored copy.
FMP_API_URL=https://app.financialmodelerpro.com
FMP_API_KEY=

# Optional
NEXT_PUBLIC_GA_ID=
