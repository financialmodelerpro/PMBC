# ── Supabase (PaceMakers project, NOT the FMP one) ───────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server only, never expose
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Admin access ─────────────────────────────────────────────────────────────
# BOTH are required. If either is missing every admin route DENIES.
# That is deliberate: an unconfigured deployment must be locked, not open.
ADMIN_PASSWORD=choose-a-long-random-password
ADMIN_SESSION_SECRET=another-long-random-string-32-chars-plus
ADMIN_EMAIL=you@pacemakers.example

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
